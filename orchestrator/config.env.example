# Orchestrator configuration
# Copy to config.env and fill in values
# The orchestrator sources this file and exports all vars before launching Claude Code.
# The MCP server subprocess inherits these env vars automatically.

# Dashboard API
DASHBOARD_URL=https://projects.example.com
DASHBOARD_API_KEY=your_dashboard_api_key

# Workspace paths
# WORKSPACE_DIR is the base directory for repo clones (used by setup-repo.sh)
# TRACKER_REPO is the project-tracker repo itself (always pulled by the orchestrator)
# Individual repo paths are managed via the dashboard UI — no need to hardcode them here.
WORKSPACE_DIR=/home/deploy/workspace
TRACKER_REPO=${WORKSPACE_DIR}/project-tracker

# Mailgun (email)
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=mail.example.com
AGENT_EMAIL=agent@mail.example.com

# Twilio (SMS)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM=+10000000000
TWILIO_TO=+10000000000

# Honeybadger
HONEYBADGER_AUTH_TOKEN=your_honeybadger_token

# Hatchbox
HATCHBOX_API_TOKEN=your_hatchbox_token
HATCHBOX_ERP_WEBHOOK=https://app.hatchbox.io/webhooks/deployments/YOUR_TOKEN
HATCHBOX_COMMPORTAL_WEBHOOK=https://app.hatchbox.io/webhooks/deployments/YOUR_TOKEN

# GitHub Webhooks
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret

# Claude Code auth (uncomment when switching from Max to API)
# ANTHROPIC_API_KEY=your_anthropic_api_key
