{
  "permissions": {
    "allow": [
      "Bash(bash -l -c \"rvm <your-ruby>@<your-gemset> do bundle exec bin/rails test*\")",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(bundle exec standardrb *)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(cat *)",
      "Bash(which *)",
      "Bash(node *)",
      "Bash(npm *)",
      "mcp__project-tracker-agent__*"
    ],
    "deny": []
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "eval \"$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)\" && prove_it verify"
          },
          {
            "type": "command",
            "command": "eval \"$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)\" && turbocommit commit"
          }
        ]
      }
    ]
  }
}
