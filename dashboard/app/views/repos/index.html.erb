<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-gray-900">Repos</h1>
  <%= link_to "Add Repo", new_repo_path, class: "bg-purple-600 text-white px-4 py-2 rounded-lg text-sm hover:bg-purple-700" %>
</div>

<% if @repos.any? %>
  <div class="border rounded-lg divide-y">
    <% @repos.each do |repo| %>
      <div class="p-4 flex items-center justify-between">
        <div>
          <div class="flex items-center gap-3">
            <%= link_to repo.name, repo, class: "font-medium text-gray-900 hover:text-purple-700" %>
            <span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium
              <%= case repo.setup_status
                  when "ready" then "bg-green-50 text-green-700"
                  when "pending" then "bg-yellow-50 text-yellow-700"
                  when "setting_up" then "bg-blue-50 text-blue-700"
                  when "failed" then "bg-red-50 text-red-700"
                  end %>">
              <%= repo.setup_status %>
            </span>
            <% if repo.framework.present? %>
              <span class="text-xs text-gray-500"><%= repo.framework %></span>
            <% end %>
          </div>
          <div class="text-sm text-gray-500 mt-1">
            <span class="font-mono text-xs"><%= repo.github_url %></span>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <%= link_to "Edit", edit_repo_path(repo), class: "text-sm text-gray-600 hover:text-gray-900" %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="text-center py-12 text-gray-400">
    <p class="text-lg">No repos configured yet.</p>
    <p class="text-sm mt-1">Add a repo to get started.</p>
  </div>
<% end %>
