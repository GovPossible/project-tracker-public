<div class="mb-6">
  <%= link_to "&larr; Repos".html_safe, repos_path, class: "text-sm text-purple-700 hover:underline" %>
</div>

<div class="flex items-start justify-between gap-4 mb-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900"><%= @repo.name %></h1>
    <div class="flex items-center gap-3 mt-2">
      <span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium
        <%= case @repo.setup_status
            when "ready" then "bg-green-50 text-green-700"
            when "pending" then "bg-yellow-50 text-yellow-700"
            when "setting_up" then "bg-blue-50 text-blue-700"
            when "failed" then "bg-red-50 text-red-700"
            end %>">
        <%= @repo.setup_status %>
      </span>
      <% if @repo.framework.present? %>
        <span class="text-xs text-gray-500"><%= @repo.framework %></span>
      <% end %>
    </div>
  </div>
  <div class="flex gap-2 shrink-0">
    <% if @repo.failed? || @repo.pending? %>
      <%= button_to "Retry Setup", retry_setup_repo_path(@repo), method: :post, class: "bg-yellow-50 text-yellow-700 px-3 py-1.5 rounded-lg text-sm hover:bg-yellow-100 cursor-pointer" %>
    <% end %>
    <%= link_to "Edit", edit_repo_path(@repo), class: "bg-gray-100 text-gray-700 px-3 py-1.5 rounded-lg text-sm hover:bg-gray-200" %>
    <%= link_to "Delete", @repo, data: { turbo_method: :delete, turbo_confirm: "Delete this repo?" }, class: "bg-red-50 text-red-700 px-3 py-1.5 rounded-lg text-sm hover:bg-red-100" %>
  </div>
</div>

<div class="border rounded-lg p-4 space-y-3">
  <div class="grid grid-cols-2 gap-4 text-sm">
    <div>
      <span class="text-gray-500">GitHub URL</span>
      <p class="font-mono text-gray-900"><%= link_to @repo.github_url, @repo.github_url, target: "_blank", class: "text-purple-700 hover:underline" %></p>
    </div>
    <div>
      <span class="text-gray-500">Local Path</span>
      <p class="font-mono text-gray-900"><%= @repo.local_path || "—" %></p>
    </div>
    <div>
      <span class="text-gray-500">Ruby Version</span>
      <p class="text-gray-900"><%= @repo.ruby_version || "—" %></p>
    </div>
    <div>
      <span class="text-gray-500">RVM Gemset</span>
      <p class="font-mono text-gray-900"><%= @repo.gemset || "—" %></p>
    </div>
    <div>
      <span class="text-gray-500">Framework</span>
      <p class="text-gray-900"><%= @repo.framework || "—" %></p>
    </div>
    <div>
      <span class="text-gray-500">Test Command</span>
      <p class="font-mono text-gray-900"><%= @repo.test_command || "—" %></p>
    </div>
  </div>
</div>

<% if @repo.setup_log.present? %>
  <div class="mt-6">
    <h2 class="text-sm font-medium text-gray-500 mb-2">Setup Log</h2>
    <pre class="bg-gray-900 text-gray-100 rounded-lg p-4 text-xs overflow-x-auto max-h-96"><%= @repo.setup_log %></pre>
  </div>
<% end %>
