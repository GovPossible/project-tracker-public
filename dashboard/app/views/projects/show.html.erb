<div class="mb-6">
  <%= link_to "&larr; Projects".html_safe, projects_path, class: "text-sm text-purple-700 hover:underline" %>
</div>

<div class="flex items-start justify-between gap-4 mb-6">
  <div class="min-w-0">
    <h1 class="text-2xl font-bold text-gray-900 break-words"><%= @project.title %></h1>
    <div class="flex items-center gap-2 mt-2">
      <%= status_badge(@project.status) %>
      <%= waiting_on_badge(@project) %>
      <% if @project.waiting_input? && !@project.replies.recent.first&.from_address&.include?("Admin") %>
        <%= button_to "Nudge Agent", nudge_project_path(@project), method: :post, class: "inline-block px-2 py-0.5 rounded-full text-xs font-medium bg-blue-50 text-blue-700 hover:bg-blue-100 cursor-pointer" %>
      <% end %>
      <%= priority_badge(@project.priority) %>
      <span class="text-xs text-gray-500">Source: <%= @project.source.humanize %></span>
      <span class="text-xs text-gray-500">Attempts: <%= @project.attempt_count %>/<%= @project.max_attempts %></span>
    </div>
  </div>
  <div class="flex gap-2 shrink-0">
    <% unless @project.queued? %>
      <%= button_to "Requeue", project_path(@project, project: { status: :queued }), method: :patch, class: "bg-gray-100 text-gray-700 px-3 py-1.5 rounded-lg text-sm hover:bg-gray-200" %>
    <% end %>
    <% if @project.working? || @project.waiting_input? %>
      <%= button_to "Mark Failed", project_path(@project, project: { status: :failed }), method: :patch, class: "bg-orange-50 text-orange-700 px-3 py-1.5 rounded-lg text-sm hover:bg-orange-100" %>
    <% end %>
    <% if @project.pr_review? || @project.staging? %>
      <%= button_to "Mark Done", project_path(@project, project: { status: :done }), method: :patch, class: "bg-green-50 text-green-700 px-3 py-1.5 rounded-lg text-sm hover:bg-green-100" %>
    <% end %>
    <%= link_to "Edit", edit_project_path(@project), class: "bg-gray-100 text-gray-700 px-3 py-1.5 rounded-lg text-sm hover:bg-gray-200" %>
    <%= link_to "Delete", @project, data: { turbo_method: :delete, turbo_confirm: "Delete this project?" }, class: "bg-red-50 text-red-700 px-3 py-1.5 rounded-lg text-sm hover:bg-red-100" %>
  </div>
</div>

<% if @project.repos.any? %>
  <div class="flex gap-4 mb-4 text-sm">
    <span class="text-gray-500">Repos:</span>
    <% @project.repos.each do |repo| %>
      <span class="font-mono text-gray-700"><%= repo %></span>
    <% end %>
  </div>
<% end %>

<% if @project.branches.any? %>
  <div class="flex gap-4 mb-4 text-sm">
    <span class="text-gray-500">Branches:</span>
    <% @project.branches.each do |repo, branch| %>
      <span class="font-mono text-gray-700"><%= repo %>: <%= branch %></span>
    <% end %>
  </div>
<% end %>

<% if @project.pr_urls.any? %>
  <div class="flex gap-4 mb-4 text-sm">
    <span class="text-gray-500">PRs:</span>
    <% @project.pr_urls.each do |repo, url| %>
      <% pr_number = url.split("/").last %>
      <%= link_to "#{repo}: ##{pr_number} #{@project.title}", url, target: "_blank", class: "text-purple-700 hover:underline" %>
    <% end %>
  </div>
<% end %>

<% if @project.description.present? %>
  <div class="prose prose-sm max-w-none mb-8 p-4 bg-gray-50 rounded-lg overflow-x-auto break-words">
    <%= render_markdown(@project.description) %>
  </div>
<% end %>

<% if @project.file_urls.any? %>
  <div class="mb-8">
    <h2 class="text-sm font-medium text-gray-500 mb-2">Attachments</h2>
    <div class="space-y-1">
      <% @project.file_urls.each do |url| %>
        <% filename = File.basename(URI.parse(url).path) %>
        <div class="flex items-center gap-2 text-sm">
          <% if url.match?(/\.(png|jpe?g|gif|webp|svg)$/i) %>
            <a href="<%= url %>" target="_blank" rel="noopener">
              <img src="<%= url.sub('/upload/', '/upload/c_limit,h_40,w_40/') %>" class="h-10 w-10 rounded border object-cover" alt="<%= filename %>">
            </a>
          <% end %>
          <%= link_to filename, url, target: "_blank", rel: "noopener", class: "text-purple-700 hover:underline" %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
  <div>
    <h2 class="text-lg font-semibold text-gray-900 mb-3">Activity Timeline</h2>
    <div class="border rounded-lg divide-y">
      <% @activities.each do |activity| %>
        <div class="p-3">
          <div class="flex items-center justify-between">
            <span class="font-medium text-sm text-gray-900"><%= activity.action.humanize %></span>
            <span class="text-xs text-gray-400"><%= time_ago_in_words(activity.created_at) %> ago</span>
          </div>
          <% if activity.details.present? %>
            <p class="text-sm text-gray-600 mt-1"><%= activity.details %></p>
          <% end %>
        </div>
      <% end %>
      <% if @activities.empty? %>
        <div class="p-4 text-center text-gray-400 text-sm">No activity yet.</div>
      <% end %>
    </div>
  </div>

  <div>
    <h2 class="text-lg font-semibold text-gray-900 mb-3">Replies</h2>
    <div class="border rounded-lg divide-y">
      <% @replies.each do |reply| %>
        <div class="p-3 <%= reply.read? ? "bg-white" : "bg-yellow-50" %>">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-xs font-medium px-1.5 py-0.5 rounded <%= channel_badge_class(reply.channel) %>">
                <%= reply.channel.upcase %>
              </span>
              <span class="text-xs text-gray-500"><%= reply.from_address %></span>
            </div>
            <span class="text-xs text-gray-400"><%= time_ago_in_words(reply.created_at) %> ago</span>
          </div>
          <% if reply.body.present? %>
            <div class="prose prose-sm max-w-none mt-1 text-gray-700"><%= render_markdown(reply.body) %></div>
          <% end %>
          <% if reply.image_urls.present? %>
            <div class="flex flex-wrap gap-2 mt-2">
              <% reply.image_urls.each do |url| %>
                <a href="<%= url %>" target="_blank" rel="noopener">
                  <img src="<%= url.sub('/upload/', '/upload/c_limit,h_200,w_200/') %>" alt="Attached image" class="h-20 rounded border hover:opacity-80">
                </a>
              <% end %>
            </div>
          <% end %>
          <% unless reply.read? %>
            <span class="text-xs text-yellow-600 font-medium">Unread</span>
          <% end %>
        </div>
      <% end %>
      <% if @replies.empty? %>
        <div class="p-4 text-center text-gray-400 text-sm">No replies yet.</div>
      <% end %>
    </div>

    <% unless @project.done? || @project.failed? %>
      <%= form_with url: add_reply_project_path(@project), method: :post, class: "mt-4",
            data: { controller: "image-upload", image_upload_cloud_name_value: ENV["CLOUDINARY_CLOUD_NAME"], image_upload_upload_preset_value: ENV["CLOUDINARY_UPLOAD_PRESET"] } do |f| %>
        <textarea name="body" rows="3" placeholder="Add a comment..." required
          data-image-upload-target="textarea" data-action="paste->image-upload#paste"
          class="w-full rounded-lg border-gray-300 shadow-sm text-sm focus:border-purple-500 focus:ring-purple-500"></textarea>
        <div data-image-upload-target="preview" class="flex flex-wrap gap-2 mt-2"></div>
        <input type="file" accept="image/*" class="hidden" data-image-upload-target="fileInput" data-action="change->image-upload#fileSelected">
        <div class="mt-2 flex items-center justify-between">
          <button type="button" data-action="image-upload#selectFile"
            class="text-sm text-purple-600 hover:text-purple-800 cursor-pointer">Attach image</button>
          <%= f.submit "Add Comment", class: "bg-purple-600 text-white px-4 py-2 rounded-lg text-sm hover:bg-purple-700 cursor-pointer" %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
